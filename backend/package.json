{
  "name": "cuisine-backend",
  "version": "1.0.0",
  "description": "Backend Club Quisine — auth Google OAuth via Better Auth",
  "main": "server.js",
  "type": "module",
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "migrate": "node scripts/migrate.js",
    "test": "node --test",
    "audit": "npm audit --audit-level=high"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1136.0",
    "@aws-sdk/s3-request-presigner": "^3.1136.0",
    "better-auth": "^1.7.5",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^5.2.1",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.3.0",
    "kysely": "^0.28.17",
    "mysql2": "^3.24.4",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  },
  "pnpm": {
    "overrides": {
      "picomatch": "^4.0.4"
    },
    "auditConfig": {
      "ignoreGhsas": []
    }
  }
}
